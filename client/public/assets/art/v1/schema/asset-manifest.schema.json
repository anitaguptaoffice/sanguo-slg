{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-slg.local/assets/art/v1/schema/asset-manifest.schema.json",
  "title": "Sanguo SLG Art Manifest v1",
  "description": "DRAFT — not frozen. ART-SAMPLE-001: standalone PNG only, no atlas; full pipeline (atlas, crop) is a later gate.",
  "type": "object",
  "required": ["schema_version", "pack", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "pack": {
      "type": "string",
      "enum": ["maincity", "world", "ui", "shared"],
      "description": "Logical pack; world tiles must not reuse maincity display sizes."
    },
    "texture_delivery": {
      "type": "string",
      "enum": ["standalone_png", "atlas"],
      "default": "standalone_png",
      "description": "ART-SAMPLE-001 requires standalone_png. Atlas packing is not validated in the sample batch."
    },
    "base_url": {
      "type": "string",
      "default": "/assets/art/v1/",
      "description": "Prefix for relative paths; prepend Vite import.meta.env.BASE_URL at runtime."
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" },
      "minItems": 1
    }
  },
  "$defs": {
    "vec2": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "size2": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "nineSlice": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "top": { "type": "integer", "minimum": 0 },
        "right": { "type": "integer", "minimum": 0 },
        "bottom": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "description": "Margins in source pixels at 1x; scale margins ×2 for 2x source."
    },
    "scaleVariant": {
      "type": "object",
      "required": ["scale", "path"],
      "properties": {
        "scale": { "type": "number", "enum": [1, 2] },
        "path": {
          "type": "string",
          "description": "Relative to base_url; standalone PNG path (no atlas in sample batch)."
        },
        "atlas": {
          "type": "string",
          "description": "Reserved for future atlas pipeline; omit for ART-SAMPLE-001."
        },
        "frame": {
          "type": "string",
          "description": "Reserved for future atlas frames; omit for ART-SAMPLE-001."
        }
      },
      "additionalProperties": false
    },
    "scalePathList": {
      "type": "array",
      "items": { "$ref": "#/$defs/scaleVariant" },
      "minItems": 1,
      "description": "Typically both scale 1 and 2 for sample set."
    },
    "buttonStates": {
      "type": "object",
      "required": ["normal", "hover", "pressed", "disabled"],
      "properties": {
        "normal": { "$ref": "#/$defs/scalePathList" },
        "hover": { "$ref": "#/$defs/scalePathList" },
        "pressed": { "$ref": "#/$defs/scalePathList" },
        "disabled": { "$ref": "#/$defs/scalePathList" }
      },
      "additionalProperties": false,
      "description": "Each state lists 1x and 2x standalone PNG paths."
    },
    "asset": {
      "type": "object",
      "required": ["id", "kind", "display_size", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+\\.v[0-9]+$",
          "description": "Stable asset id, e.g. mc.building.farm.v1"
        },
        "kind": {
          "type": "string",
          "enum": ["sprite", "nine_slice", "button", "icon", "background"]
        },
        "display_size": {
          "$ref": "#/$defs/size2",
          "description": "Logical size: layout frame for sprites; stage 1600x788 for mc.bg.plateau.v1"
        },
        "crop_offset": {
          "$ref": "#/$defs/vec2",
          "description": "Optional trim from source; omit in ART-SAMPLE-001 (uncropped PNGs)."
        },
        "anchor": {
          "$ref": "#/$defs/vec2",
          "description": "Pixel or normalized offset from display rect top-left"
        },
        "anchor_unit": { "type": "string", "enum": ["normalized", "pixels"], "default": "pixels" },
        "variants": {
          "$ref": "#/$defs/scalePathList",
          "description": "1x/2x for sprite, icon, background, nine_slice (not used when button_states is set)."
        },
        "atlas_page": {
          "type": "string",
          "description": "Future atlas pipeline only; omit for standalone_png delivery."
        },
        "physical_frame": {
          "type": "object",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "w": { "type": "integer" },
            "h": { "type": "integer" }
          },
          "additionalProperties": false,
          "description": "Future atlas pipeline only."
        },
        "nine_slice": { "$ref": "#/$defs/nineSlice" },
        "button_states": { "$ref": "#/$defs/buttonStates" },
        "slot_key": {
          "type": "string",
          "enum": ["hall", "farm", "lumber", "quarry", "iron", "barracks", "wall"],
          "description": "Only for maincity building sprites"
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
